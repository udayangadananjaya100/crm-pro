{
  "$schema": "workspace-rules/v2.1.0",
  "version": "2.1.0",
  "last_updated": "2026-05-08T15:48:00+05:30",
  "environment": "production",

  "workspace": {
    "name": "Pro CRM — WhatsApp Business Platform",
    "description": "Production-grade WhatsApp CRM integrated with Meta Cloud API for lead management, customer support, and sales automation.",
    "owner": "Vieora Digital Solutions",
    "region": "LK",
    "timezone": "Asia/Colombo",
    "default_currency": "LKR"
  },

  "deployment": {
    "runtime": "Node.js",
    "framework": "Express",
    "queue_engine": "BullMQ",
    "database": "PostgreSQL",
    "cache": "Redis",
    "api_provider": "Meta Cloud API v21.0",
    "ai_provider": "Google Gemini",
    "hosting": "VPS / Cloud"
  },

  "business_hours": {
    "enabled": false,
    "timezone": "Asia/Colombo",
    "schedule": {
      "monday":    { "start": "08:00", "end": "20:00" },
      "tuesday":   { "start": "08:00", "end": "20:00" },
      "wednesday": { "start": "08:00", "end": "20:00" },
      "thursday":  { "start": "08:00", "end": "20:00" },
      "friday":    { "start": "08:00", "end": "20:00" },
      "saturday":  { "start": "09:00", "end": "17:00" },
      "sunday":    { "start": "10:00", "end": "14:00" }
    },
    "holidays": [],
    "off_hours_behavior": "template_only",
    "off_hours_reply_template": "off_hours_auto_reply"
  },

  "messaging": {
    "provider": "meta_cloud_api",
    "api_version": "v21.0",
    "phone_number_id": "${WHATSAPP_PHONE_NUMBER_ID}",
    "business_account_id": "${WHATSAPP_BUSINESS_ACCOUNT_ID}",
    "webhook_verify_token": "${WEBHOOK_VERIFY_TOKEN}",
    "access_token": "${WHATSAPP_ACCESS_TOKEN}",
    "max_message_length": 4096,
    "rate_limit": {
      "per_second": 80,
      "per_minute": 1000,
      "per_hour": 10000
    },
    "media_support": {
      "images": true,
      "documents": true,
      "audio": true,
      "video": true,
      "stickers": true,
      "max_file_size_mb": 16
    }
  },

  "conversational_window": {
    "duration_hours": 24,
    "free_form_allowed": true,
    "outside_window_action": "template_required",
    "auto_extend_on_reply": true,
    "grace_period_minutes": 5
  },

  "spam_detection": {
    "enabled": true,
    "rate_limit_per_sender": {
      "max_messages_per_minute": 10,
      "max_messages_per_hour": 60,
      "cooldown_minutes": 15
    },
    "patterns": [
      "repeated_identical_messages",
      "rapid_fire_messages",
      "known_spam_signatures",
      "url_flooding"
    ],
    "action_on_detect": "suppress_and_flag"
  },

  "features": {
    "ai_auto_reply": true,
    "lead_capture": true,
    "ticket_system": true,
    "broadcast_messaging": true,
    "catalog_integration": false,
    "payment_integration": false,
    "multi_agent_routing": true,
    "sentiment_analysis": true,
    "language_detection": true,
    "conversation_tagging": true,
    "customer_segmentation": true,
    "analytics_dashboard": true
  },

  "notifications": {
    "channels": ["email", "slack", "in_app"],
    "escalation_alerts": true,
    "sla_breach_alerts": true,
    "daily_report": true,
    "report_time": "09:00",
    "manager_email": "${MANAGER_EMAIL}",
    "slack_webhook": "${SLACK_WEBHOOK_URL}"
  },

  "database": {
    "provider": "postgresql",
    "connection_string": "${DATABASE_URL}",
    "pool_size": 20,
    "ssl": true,
    "schema": "pro_crm",
    "migrations_dir": "db/migrations",
    "backup": {
      "enabled": true,
      "frequency": "daily",
      "retention_days": 90
    }
  },

  "redis": {
    "connection_string": "${REDIS_URL}",
    "queue_prefix": "procrm:",
    "session_ttl_seconds": 86400,
    "cache_ttl_seconds": 3600
  },

  "logging": {
    "level": "info",
    "format": "json",
    "destinations": ["stdout", "file", "database"],
    "log_file_path": "logs/procrm.log",
    "rotation": {
      "max_size_mb": 50,
      "max_files": 30
    },
    "audit_logging": {
      "enabled": true,
      "table": "audit_logs",
      "retention_days": 365
    }
  },

  "security": {
    "helmet_enabled": true,
    "cors_origins": ["${ADMIN_DASHBOARD_URL}"],
    "api_key_header": "X-API-Key",
    "jwt_secret": "${JWT_SECRET}",
    "jwt_expiry": "24h",
    "rate_limiting": {
      "enabled": true,
      "window_ms": 60000,
      "max_requests": 100
    },
    "ip_whitelist": [],
    "encryption": {
      "algorithm": "aes-256-gcm",
      "key_rotation_days": 90
    }
  }
}
