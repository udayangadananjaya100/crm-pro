# ============================================
# Pro CRM — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/pro_crm
DB_SSL=false

# Redis (for BullMQ queues & caching)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_API_VERSION=v21.0

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRY=24h

# Admin Dashboard
ADMIN_DASHBOARD_URL=http://localhost:3000

# Notifications
MANAGER_EMAIL=manager@yourcompany.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Logging
LOG_LEVEL=info
